# Secrets — never commit API keys
.env
.env.*
!.env.example

# Virtual environment (rebuild with: python -m venv .venv && pip install -r backend/requirements.txt)
.venv/
venv/

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Front end
node_modules/
frontend/dist/

# OS / editor clutter
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local setup smoke test (not part of the project; it uses gpt-5.6-luna)
joke.py
today_joke.txt

# Raw personal exports (only the anonymized sample in data/sample/ is committed)
data/raw/
uploads/

# Runtime logs (regenerated on every run)
logs/
output/_*
*.json.tmp
